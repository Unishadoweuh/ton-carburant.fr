# Copier en .env puis adapter.

# --- Tunnel Cloudflare -------------------------------------------------------
# "tunnel"        : tunnel créé dans le dashboard Cloudflare (jeton TUNNEL_TOKEN)
# "tunnel-config" : tunnel géré localement avec cloudflared/config.yml
# vide            : pas de tunnel (accès local uniquement)
COMPOSE_PROFILES=tunnel
TUNNEL_TOKEN=

# --- Exposition locale -------------------------------------------------------
# 0.0.0.0 pour accéder à l'app depuis le réseau local
APP_BIND=127.0.0.1
APP_PORT=8000

# --- Recherche ---------------------------------------------------------------
DEFAULT_RADIUS_KM=10
MAX_RADIUS_KM=50
RADIUS_OPTIONS_KM=5,10,15,20,30,50

# --- Import du flux officiel -------------------------------------------------
INGEST_INTERVAL_MINUTES=10
# En dessous de ce nombre de stations, le flux est jugé incomplet et ignoré
INGEST_MIN_STATIONS=1000
# FEED_URL=https://donnees.roulez-eco.fr/opendata/instantane_ruptures
# Référentiel des enseignes (vide = pas d'enrichissement par marque)
# BRANDS_URL=https://www.data.gouv.fr/api/1/datasets/r/0207ded0-2d19-47af-b1a6-62915ec1b721
# HTTP_TIMEOUT_S=60

# --- Géocodage (URLs séparées par des virgules, essayées dans l'ordre) -------
# GEOCODER_URLS=https://data.geopf.fr/geocodage/search,https://api-adresse.data.gouv.fr/search/

# --- Fond de carte -----------------------------------------------------------
# TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>
# TILE_MAX_ZOOM=19

LOG_LEVEL=INFO
